# Universal ignore
target/
.DS_Store
*.swp
*.bak
*~

# Environment & local secrets
.env
.env.local
.env.*.local
*.local
*.local.*

# IDE / editor artifacts
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Build & transient directories
.tmp/
.local-ci-cache/
.og-crab/
*.log

# AIVCS transient files & database
.aivcs/
.aivcs/*
.aivcs/db/
.aivcs/db/*
